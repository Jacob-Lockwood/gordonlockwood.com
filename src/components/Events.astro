---
import linkify from "linkify-string";
import { URLSearchParams } from "url";
const addressToLink = (address: string) =>
  "https://www.google.com/maps/search/?" +
  new URLSearchParams({ api: "1", query: address });
export interface Event {
  title: string;
  address: string;
  description: string;
  date: string;
}
export interface Props {
  events: Event[];
}
const { events } = Astro.props as Props;
---

<div class="flex w-full justify-center gap-8 overflow-x-scroll">
  {
    events.map(({ title, date, address, description }) => (
      <div class="w-80 flex-shrink-0 border-2 border-dashed border-blue-500 p-2 text-center text-lg">
        <h4 class="font-bold">{title}</h4>
        <time class="underline">{date}</time>
        <p>
          <a target="_blank" href={addressToLink(address)}>
            {address}
          </a>
        </p>
        <p set:html={linkify(description, { className: "underline" })} />
      </div>
    ))
  }
</div>
