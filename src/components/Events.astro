---
import linkify from "linkify-string";
import { URLSearchParams } from "url";
const addressToLink = (address: string) =>
  "https://www.google.com/maps/search/?" +
  new URLSearchParams({ api: "1", query: address });
const {format: dateFormat} = new Intl.DateTimeFormat("en-US", {
  weekday: "long",
  month: "long",
  day: "numeric",
  hour: "numeric",
  minute: "numeric",
});
const {format: timeFormat} = new Intl.DateTimeFormat("en-US", {
  hour: "numeric",
  minute: "numeric",
});
const format = (dateStr: string, length: string) => {
  const date = new Date(dateStr);
  const end = new Date(date.getTime() + (Number(length) * 60 * 60 * 1000));
  return `${dateFormat(date)} - ${timeFormat(end)}`;
};
export interface Event {
  title: string;
  address: string;
  description: string;
  date: string;
  length: string;
}
export interface Props {
  events: Event[];
}
const { events } = Astro.props as Props;
---

<div class="events">
  {
    events.map(({ title, date, address, description, length }) => (
      <div class="event">
        <h4>{title}</h4>
        <time datetime={date}>{format(date, length)}</time>
        <p>
          <a target="_blank" href={addressToLink(address)}>{address}</a>
        </p>
        <p set:html={linkify(description)} />
      </div>
    ))
  }
</div>

<style>
  .events {
    display: flex;
    width: 100%;
    overflow-x: scroll;
    gap: 2em;
    box-shadow: inset -0.5em 0 0.5em -0.3em navy;
  }
  .event {
    width: 40ch;
    flex-shrink: 0;
    border: 3px dashed;
    padding: 0.5em;
  }
  .event time {
    text-decoration: underline;
    text-underline-offset: 0.4em;
  }
</style>
