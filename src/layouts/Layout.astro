---
export interface Props {
  title: string;
}

const year = new Date().getFullYear();

const { title } = Astro.props as Props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Monoton&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="font-body bg-indigo-200 text-blue-950">
    <div class="flex w-screen">
      <div
        class="hidden w-[10%] flex-shrink-0 bg-[url('/images/margin-left.webp')] bg-contain md:block"
      >
      </div>
      <div class="px-20">
        <main>
          <slot />
        </main>
        <footer class="mt-40 flex min-h-80 flex-col items-center gap-6 p-10">
          <h2>Contact us!</h2>
          <h3>
            <a href="mailto:jeremiahdaniellockwood@yahoo.com" class="underline">
              jeremiahdaniellockwood@yahoo.com
            </a>
          </h3>
          <ul class="flex items-center gap-10">
            <li>
              <a
                href="https://www.youtube.com/channel/UC8ve7pvyF9rQMX02fBXgTsw"
              >
                <img
                  src="images/youtube.svg"
                  alt="YouTube"
                  class="w-10 invert"
                />
              </a>
            </li>
            <li>
              <a href="https://www.facebook.com/jeremiah.lockwood">
                <img
                  src="images/facebook.svg"
                  alt="Facebook"
                  class="w-10 invert"
                />
              </a>
            </li>
          </ul>
          <p>&copy; Gordon Lockwood {year}</p>
          <p class="opacity-70">
            Website created by <a
              href="mailto:jacobulysseslockwood@gmail.com"
              class="underline">Jacob Lockwood</a
            >
          </p>
        </footer>
      </div>
      <div
        class="hidden w-[10%] flex-shrink-0 bg-[url('/images/margin-right.webp')] bg-contain md:block"
      >
      </div>
    </div>
  </body>
</html>
