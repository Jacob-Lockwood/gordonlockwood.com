---
export interface Props {
  title: string;
}

const year = new Date().getFullYear();

const { title } = Astro.props as Props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,300;0,500;1,300&family=Rubik+Mono+One&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <main>
      <slot />

      <footer>
        <h2>Contact us!</h2>
        <h3>
          <a href="mailto:jeremiahdaniellockwood@yahoo.com">
            jeremiahdaniellockwood@yahoo.com
          </a>
        </h3>
        <ul class="socials">
          <li>
            <a href="https://www.youtube.com/channel/UC8ve7pvyF9rQMX02fBXgTsw">
              <img src="images/youtube.svg" alt="YouTube" />
            </a>
          </li>
          <li>
            <a href="https://www.facebook.com/jeremiah.lockwood">
              <img src="images/facebook.svg" alt="Facebook" />
            </a>
          </li>
        </ul>
        <p>© Gordon Lockwood {year}</p>
      </footer>
    </main>
    <style>
      :root {
        --font-size-base: clamp(1rem, 0.34vw + 0.91rem, 1.19rem);
        --font-size-lg: clamp(1.2rem, 0.7vw + 1.2rem, 1.5rem);
        --font-size-xl: clamp(2.44rem, 3vw + 2.5rem, 5rem);

        --color-text: hsl(12, 5%, 4%);
        --color-bg: hsl(10, 21%, 95%);
        --color-border: hsl(17, 24%, 90%);
      }

      html {
        font-family: system-ui, sans-serif;
        font-size: var(--font-size-base);
        color: var(--color-text);
        background-color: var(--color-bg);
      }

      body {
        margin: 0;
      }

      :global(h1, h2) {
        text-align: center;
      }
      :global(h1) {
        font-size: var(--font-size-xl);
      }

      :global(h2) {
        font-size: var(--font-size-lg);
      }

      :global(code) {
        font-family: Menlo, Monaco, Lucida Console, Liberation Mono,
          DejaVu Sans Mono, Bitstream Vera Sans Mono, Courier New, monospace;
      }

      main {
        display: flex;
        flex-direction: column;
        align-items: center;
        max-width: 100vw;
        padding: 1em;
      }

      main::before,
      main::after {
        content: "";
        position: fixed;
        top: 0;
        right: 0;
        width: 10%;
        height: 100%;
        background-size: 100%;
        background-image: url(/images/margin-right.webp);
      }

      main::before {
        left: 0;
        background-image: url(/images/margin-left.webp);
      }

      @media (max-width: 600px) {
        section,
        footer {
          width: 100%;
        }
        main::before,
        main::after {
          content: none;
        }
      }

      :global(*) {
        box-sizing: border-box;
      }

      html,
      body {
        position: relative;
        width: 100%;
        height: 100%;
        scroll-behavior: smooth;
        /* scroll-padding-top: 5rem; */
      }

      body {
        color: navy;
        margin: 0;
        padding: 8px;
        box-sizing: border-box;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
        background: whitesmoke;
      }

      :global(a, a:visited) {
        color: rgb(0, 0, 200);
        text-decoration: none;
      }

      :global(a:hover) {
        text-decoration: underline;
      }

      :global(section),
      footer {
        position: relative;
        display: flex;
        gap: 1em;
        justify-content: center;
        width: 80%;
        margin-bottom: 2em;
      }

      :global(section > *) {
        flex-basis: 100%;
      }
      footer {
        text-align: center;
        display: block;
        background-color: navy;
        padding: 2em;
        color: white;
      }
      footer h2,
      footer h3 {
        margin: 0;
      }
      footer a {
        color: whitesmoke;
        width: 100%;
        text-decoration: underline;
        word-wrap: break-word;
      }
      .socials {
        width: 100%;
        justify-content: center;
        display: flex;
        list-style: none;
        gap: 2em;
        padding: 0;
      }
      .socials img {
        width: 3em;
      }

      :global(img) {
        width: 100%;
        object-fit: contain;
      }
    </style>
  </body>
</html>
